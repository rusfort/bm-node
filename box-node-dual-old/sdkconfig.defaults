# Box Node Dual — ESP32-S3 N8R2 (YD-ESP32-S3), ESP-IDF v5.5.x, роли CORE и TX
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Bluetooth: только BLE, стек NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Одновременно peripheral (TX) и central (RX)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# Пакеты V1 до 512 байт в одном notification
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

# Меньше шума от стека, чтобы были видны шаги теста
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
